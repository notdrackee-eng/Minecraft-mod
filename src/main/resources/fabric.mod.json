
{
  "schemaVersion": 1,
  "id": "minecrart_mod",
  "version": "1.0.0",
  "name": "Minecraft Mod Menu Manager",
  "description": "Manage mod and keybind visibility.",
  "environment": "client",
  "entrypoints": {
